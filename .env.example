# Copy this file to .env.local and fill in real values.
# .env.local is never committed (see .gitignore) — this file is the only
# one that is, and it must never contain a real secret.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Admin login (see README.md "Admin setup") ---
ADMIN_EMAIL=admin@example.com
# Generate with: node scripts/hash-admin-password.js "your-new-password"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- AI chat widget (see AI_PLATFORM_README.md) ---
# From https://console.anthropic.com. Leave blank to run with AI chat disabled.
ANTHROPIC_API_KEY=

# --- Publishing (see lib/publish.js / README.md "Publishing the public site") ---
# After every Project/News change, the admin server regenerates
# public-data/*.json + sitemap.xml and best-effort git-pushes them so your
# static host (GitHub Pages / Cloudflare Pages / Vercel static / ...)
# redeploys the public site automatically. This uses whatever git remote +
# credentials are already configured on this machine (git remote -v /
# git credential manager) — nothing extra to set here in the normal case.
# Set to "false" only if you want to review/push publishes yourself
# (`npm run publish-site`) instead of having every admin save auto-push.
GIT_AUTO_PUSH=true
